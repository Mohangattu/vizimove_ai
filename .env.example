# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Port configuration (default 3000 for local dev and preview)
PORT=3000

# ViziMove AI API Key: Required server-side secret for authenticating machine-to-machine
# mutating API requests (e.g., n8n automated batch ingestion, source reconfiguration, pipeline triggers).
#
# SECURITY & LOCAL SETUP INSTRUCTIONS:
# 1. To configure locally, copy this file to `.env`:
#      cp .env.example .env
# 2. Set a strong secret key, e.g.:
#      VIZIMOVE_API_KEY="vizimove_secret_api_key_example"
#    or generate a cryptographic key:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Clients passing `X-API-Key: <your_key>` will be verified in constant time.
# 4. FAIL-SAFE BEHAVIOR: If VIZIMOVE_API_KEY is not set or empty, all API-key authenticated
#    mutation routes fail safely with HTTP 503 (API_KEY_NOT_CONFIGURED). Access is never granted by default.
# 5. BROWSER DASHBOARD: The same-origin React dashboard does NOT use or know this key;
#    it uses server-side Session + CSRF tokens via /api/auth/session.
VIZIMOVE_API_KEY="vizimove_secret_api_key_example"

# Backend URL used by n8n workflow for batch event ingestion
VIZIMOVE_BACKEND_URL="http://localhost:3000"

# n8n Webhook URL: Optional. When set, the backend fires a fire-and-forget notification
# to this URL after each event ingestion cycle. Keep n8n optional — omit or leave empty
# to disable without any change to the ingest route behavior.
# Add this exact line to your .env (never commit real values):
N8N_WEBHOOK_URL="http://localhost:5678/webhook-test/vizimove"

# PostgreSQL Database Inspection & Visibility Connection (Optional)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="vizimove_db"
POSTGRES_USER="postgres"
